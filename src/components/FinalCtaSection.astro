---
// FinalCtaSection.astro - Clean Final CTA with Repeated Form
---

<section class="final-cta-section">
  <div class="container">
    <div class="final-cta-grid">
      
      <!-- Left Column: Copy & Urgent Call Actions -->
      <div class="final-cta-copy">
        <h2 class="final-cta-title">
          Stop Water Damage From Getting Worse. Get 24/7 Help Now.
        </h2>

        <p class="final-cta-desc">
          Call ER Emergency Restoration now for rapid water damage help in Los Angeles. We are ready to respond, extract water, dry affected areas, and help you begin restoring your property.
        </p>

        <!-- Primary & Secondary CTAs (Exact copy) -->
        <div class="cta-buttons-row">
          <a href="tel:8185756016" class="btn-red" style="font-size: 16px; padding: 16px 32px;">
            <i class="fa-solid fa-phone-volume"></i>
            <span>Call Now: (818) 575-6016</span>
          </a>

          <a href="#finalLeadFormCard" class="btn-navy" style="font-size: 16px; padding: 16px 28px;">
            <span>Request My Emergency Help</span>
            <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
      </div>

      <!-- Right Column: Repeated Lead Form -->
      <div class="final-cta-form-col">
        <div class="clean-form-card" id="finalLeadFormCard" style="background: #FFFFFF; color: #1E293B;">
          
          <div class="form-title-wrap">
            <h3 class="form-title">
              Get My Free, No-Obligation Water Damage Quote
            </h3>
            
            <div class="form-steps-nav">
              <span class="step-pill active bubble-step-1">1. Project Info</span>
              <span class="step-divider"><i class="fa-solid fa-angle-right"></i></span>
              <span class="step-pill bubble-step-2">2. Contact Info</span>
            </div>
          </div>

          <form id="finalLeadForm" data-landing="water-damage-restoration">
            
            <!-- STEP 1 OF 2 -->
            <div class="form-step-1">
              <div class="step-header-text">
                Tell Us About the Water Damage
              </div>

              <!-- Question 1 -->
              <div class="input-field-group">
                <label class="field-label">Are you the property owner or authorized to make restoration decisions?</label>
                <div class="pill-radio-row">
                  <label class="radio-pill-item selected">
                    <input type="radio" name="owner_auth" value="Yes" checked />
                    <span>Yes</span>
                  </label>
                  <label class="radio-pill-item">
                    <input type="radio" name="owner_auth" value="No" />
                    <span>No</span>
                  </label>
                </div>
              </div>

              <!-- Question 2 -->
              <div class="input-field-group">
                <label class="field-label">What kind of location is this?</label>
                <div class="pill-radio-row">
                  <label class="radio-pill-item selected">
                    <input type="radio" name="property_type" value="Residential" checked />
                    <span>Residential</span>
                  </label>
                  <label class="radio-pill-item">
                    <input type="radio" name="property_type" value="Commercial" />
                    <span>Commercial</span>
                  </label>
                </div>
              </div>

              <!-- Question 3 -->
              <div class="input-field-group">
                <label for="f_zip" class="field-label">ZIP Code where the property is located</label>
                <input 
                  type="text" 
                  id="f_zip"
                  name="zip" 
                  class="clean-input" 
                  placeholder="Enter ZIP Code" 
                  pattern="[0-9]{5}" 
                  maxlength="10"
                  required 
                />
              </div>

              <!-- Question 4 -->
              <div class="input-field-group">
                <label for="f_msg" class="field-label">Please describe the type of water damage or restoration project you need help with.</label>
                <textarea 
                  id="f_msg"
                  name="message" 
                  class="clean-textarea" 
                  rows="2" 
                  placeholder="Example: Burst pipe in the kitchen; water reached the cabinets and flooring."
                ></textarea>
              </div>

              <button type="button" class="btn-red btn-step-next w-100" style="width: 100%; margin-top: 6px;">
                <span>Continue</span>
                <i class="fa-solid fa-arrow-right"></i>
              </button>

              <div class="form-microcopy">
                Available 24/7. If water is actively flowing or your property is flooded, call <a href="tel:8185756016">(818) 575-6016</a> now.
              </div>
            </div>

            <!-- STEP 2 OF 2 -->
            <div class="form-step-2" style="display: none;">
              <div class="step-2-top-bar">
                <button type="button" class="btn-step-back back-btn-link">
                  <i class="fa-solid fa-arrow-left"></i> Back
                </button>
                <div class="step-header-text" style="margin: 0;">
                  How Can We Reach You?
                </div>
              </div>

              <div class="name-fields-row">
                <div class="input-field-group">
                  <label for="f_fname" class="field-label">First Name</label>
                  <input type="text" id="f_fname" name="first_name" class="clean-input" placeholder="First Name" required />
                </div>
                <div class="input-field-group">
                  <label for="f_lname" class="field-label">Last Name</label>
                  <input type="text" id="f_lname" name="last_name" class="clean-input" placeholder="Last Name" required />
                </div>
              </div>

              <div class="input-field-group">
                <label for="f_phone" class="field-label">Phone Number</label>
                <input type="tel" id="f_phone" name="phone" class="clean-input" placeholder="(818) 000-0000" required />
              </div>

              <div class="input-field-group">
                <label for="f_email" class="field-label">Email Address</label>
                <input type="email" id="f_email" name="email" class="clean-input" placeholder="your.email@example.com" required />
              </div>

              <button type="submit" class="btn-red w-100" style="width: 100%; margin-top: 6px;">
                <i class="fa-solid fa-bolt"></i>
                <span>Get My 24/7 Water Damage Help</span>
              </button>

              <div class="form-microcopy">
                Available 24/7. If water is actively flowing or your property is flooded, call <a href="tel:8185756016">(818) 575-6016</a> now.
              </div>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding: 80px 0;
    color: #FFFFFF;
    background: linear-gradient(135deg, rgba(12, 35, 64, 0.86) 0%, rgba(15, 44, 89, 0.72) 100%),
                url('/assets/images/restoration/extracting-water-carpet-2k.webp') center center / cover no-repeat;
  }
  .final-cta-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
  }
  .final-cta-title {
    font-size: clamp(28px, 3.8vw, 44px);
    font-weight: 900;
    line-height: 1.2;
    margin: 0 0 16px;
    color: #FFFFFF;
  }
  .final-cta-desc {
    font-size: 17px;
    line-height: 1.65;
    color: #CBD5E1;
    margin-bottom: 28px;
  }
  .cta-buttons-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 32px;
  }
  .guarantee-box {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 24px;
  }
  .g-item {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
    color: #E2E8F0;
  }
  .g-item i {
    font-size: 20px;
    flex-shrink: 0;
  }

  /* Form Elements */
  .clean-form-card {
    border-radius: 14px;
    padding: 28px 24px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
  }
  .form-title-wrap {
    text-align: center;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid #E2E8F0;
  }
  .form-title {
    font-size: 20px;
    font-weight: 800;
    color: #0C2340;
    line-height: 1.3;
    margin: 0 0 10px;
  }
  .form-steps-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #94A3B8;
  }
  .step-pill.active {
    color: #E62E2D;
  }
  .step-header-text {
    font-size: 14px;
    font-weight: 800;
    color: #0C2340;
    margin-bottom: 14px;
  }
  .input-field-group {
    margin-bottom: 14px;
  }
  .field-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: #334155;
    margin-bottom: 6px;
    line-height: 1.35;
  }
  .clean-input, .clean-textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid #CBD5E1;
    border-radius: 8px;
    font-size: 14px;
    color: #1E293B;
    background: transparent;
    font-family: inherit;
  }
  .clean-input:focus, .clean-textarea:focus {
    outline: none;
    border-color: #E62E2D;
    box-shadow: 0 0 0 3px rgba(230, 46, 45, 0.15);
  }
  .pill-radio-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .radio-pill-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border: 1.5px solid #CBD5E1;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    background: transparent;
    user-select: none;
  }
  .radio-pill-item input {
    display: none;
  }
  .radio-pill-item.selected {
    border-color: #E62E2D;
    background: transparent;
    color: #E62E2D;
    font-weight: 700;
  }
  .form-microcopy {
    font-size: 12px;
    color: #64748B;
    text-align: center;
    margin-top: 10px;
    line-height: 1.4;
  }
  .form-microcopy a {
    color: #E62E2D;
    font-weight: 700;
    text-decoration: underline;
  }
  .step-2-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .back-btn-link {
    background: none;
    border: none;
    color: #64748B;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
  }
  .name-fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  @media (max-width: 991px) {
    .final-cta-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  @media (max-width: 600px) {
    .final-cta-section {
      padding: 50px 0;
      overflow-x: hidden;
    }
    .cta-buttons-row {
      flex-direction: column;
      width: 100%;
      gap: 12px;
    }
    .cta-buttons-row .btn-red,
    .cta-buttons-row .btn-navy {
      width: 100% !important;
      box-sizing: border-box !important;
      padding: 14px 16px !important;
      font-size: 15px !important;
      text-align: center;
      justify-content: center;
    }
    .clean-form-card {
      padding: 20px 14px;
      box-sizing: border-box;
      width: 100%;
      max-width: 100%;
    }
  }
</style>
