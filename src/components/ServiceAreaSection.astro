---
// ServiceAreaSection.astro - Clean Service Area Coverage
---

<section class="service-area-section py-section" id="serviceAreaSection">
  <div class="container">
    <div class="service-area-grid">
      
      <!-- Left Column: Copy & Action (Exact Copy from Document) -->
      <div class="service-area-copy">
        <h2 class="section-title">
          Water Damage Restoration for Los Angeles Homes and Businesses
        </h2>

        <p class="section-desc">
          If you need emergency water damage cleanup in Los Angeles or a nearby community, contact ER Emergency Restoration now. We are available 24/7 to help property owners respond to leaks, flooding, burst pipes, appliance failures, and other water emergencies.
        </p>

        <!-- Emergency Phone Card -->
        <div class="phone-cta-card">
          <div class="phone-info">
            <span class="phone-label">Emergency Phone</span>
            <a href="tel:8185756016" class="phone-number">
              (818) 575-6016
            </a>
          </div>
          <a href="#heroLeadFormCard" class="btn-red service-cta-btn">
            <span>Request My Emergency Help</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <!-- Right Column: Authentic ER Restoration Work Photo -->
      <div class="service-area-img-col">
        <div class="img-frame">
          <img 
            src="/assets/images/photos/er-hallway-water-drying.webp" 
            alt="Water Damage Restoration for Los Angeles Homes and Businesses - ER Emergency" 
            class="feature-img"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .service-area-section {
    padding: 75px 0;
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
  }
  .service-area-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 50px;
    align-items: center;
  }
  .phone-cta-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 24px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    box-shadow: 0 4px 20px rgba(12, 35, 64, 0.04);
  }
  .phone-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 800;
    color: #E62E2D;
    letter-spacing: 0.8px;
    margin-bottom: 4px;
  }
  .phone-number {
    font-size: 24px;
    font-weight: 900;
    color: #0C2340;
    text-decoration: none;
    line-height: 1.1;
    font-family: var(--font-title);
    transition: color 0.2s ease;
  }
  .phone-number:hover {
    color: #E62E2D;
  }
  .img-frame {
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(12, 35, 64, 0.1);
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
  }
  .feature-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 991px) {
    .service-area-section {
      padding: 50px 0;
    }
    .service-area-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .phone-cta-card {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      gap: 16px;
    }
    .feature-img {
      height: 280px;
    }
  }
</style>
