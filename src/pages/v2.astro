---
// v2.astro - ER Emergency Restoration Water Damage Landing Page v2
import Layout from '../layouts/LayoutV2.astro';
import Header from '../components/v2/Header.astro';
import HeroSection from '../components/v2/HeroSection.astro';
import TrustBar from '../components/v2/TrustBar.astro';
import UrgencySection from '../components/v2/UrgencySection.astro';
import ScenariosSection from '../components/v2/ScenariosSection.astro';
import OneTeamSection from '../components/v2/OneTeamSection.astro';
import ProcessSection from '../components/v2/ProcessSection.astro';
import WhyChooseUsSection from '../components/v2/WhyChooseUsSection.astro';
import ServiceAreaSection from '../components/v2/ServiceAreaSection.astro';
import FaqSection from '../components/v2/FaqSection.astro';
import FinalCtaSection from '../components/v2/FinalCtaSection.astro';
import Footer from '../components/v2/Footer.astro';
import StickyCallBar from '../components/v2/StickyCallBar.astro';
---

<Layout
  title="24/7 Water Damage Restoration Services | ER Emergency Restoration"
  description="Rapid water extraction, structural drying, and complete restoration in Los Angeles. Licensed & insured, available 24/7. Call (818) 575-6016."
>
  <Header />

  <main>
    <HeroSection />
    <TrustBar />
    <UrgencySection />
    <ScenariosSection />
    <OneTeamSection />
    <ProcessSection />
    <WhyChooseUsSection />
    <ServiceAreaSection />
    <FaqSection />
    <FinalCtaSection />
  </main>

  <Footer />
  <StickyCallBar />
</Layout>
