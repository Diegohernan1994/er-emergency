---
// LayoutV2.astro - Base Layout for ER Emergency Restoration v2
import '../styles/global-v2.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "24/7 Water Damage Restoration Services | ER Emergency Restoration",
  description = "Rapid water extraction, structural drying, and complete restoration in Los Angeles. Licensed & insured, available 24/7. Call (818) 575-6016.",
  ogImage = "https://eremergencyrestoration.gdtwo.com/assets/images/hero/og-water-damage.jpg",
  canonicalUrl = "https://eremergencyrestoration.gdtwo.com/v2/"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-WB6P635D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / WhatsApp / Instagram / Facebook / iMessage -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ER Emergency Restoration" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="24/7 Water Damage Restoration Services - ER Emergency Restoration" />

    <!-- Twitter / X / Telegram / Discord Large Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    
    <!-- FontAwesome 6 CDN for robust iconography -->
    <link 
      rel="stylesheet" 
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
      crossorigin="anonymous" 
      referrerpolicy="no-referrer" 
    />
  </head>
  <body>
    <slot />
  </body>
</html>
